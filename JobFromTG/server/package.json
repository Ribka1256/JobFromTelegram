{
  "name": "jobfeed-server",
  "version": "2.0.0",
  "description": "JobFeed v2 — Production Express API backed by PostgreSQL/Supabase",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
